{
  "name": "qcar-speed-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Radar de velocidad vehicular en el navegador (POC) - deteccion con TensorFlow.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
